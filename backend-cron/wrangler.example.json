{
  "name": "catslop-backend-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "<MY_BUCKET>"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<database_name>",
      "database_id": "<database_id>"
    }
  ]
}