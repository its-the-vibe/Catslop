{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catslop",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "routes": [
    {
      "pattern": "catslop.uk",
      "custom_domain": true
    },
    {
      "pattern": "www.catslop.uk",
      "custom_domain": true
    },
    {
      "pattern": "catslop.its-the-vibe.uk",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "<MY_BUCKET>"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<database_name>",
      "database_id": "<database_id>"
    }
  ]
}